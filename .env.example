VITE_LEARNER_DATA_SOURCE=mock
VITE_API_BASE_URL=
VITE_BACKEND_URL=http://127.0.0.1:8080
VITE_MOCK_DEVICE_SUBMISSIONS=true
VITE_MOCK_VOICE_SUBMISSIONS=true
VITE_MOCK_GAZE_SUBMISSIONS=true
VITE_GAZE_DEBUG_PANEL=false

# Typecast TTS. Keep the real key in .env.local only.
VITE_TYPECAST_API_KEY=
VITE_TYPECAST_API_BASE_URL=https://api.typecast.ai
# Optional: skips the first Siwoo voice lookup when supplied.
VITE_TYPECAST_VOICE_ID=
